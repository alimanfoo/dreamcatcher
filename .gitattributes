# Collapse generated files in a diff, and keep them out of the language
# statistics. uncoded writes the skills; uv writes the lock.
.claude/skills/** linguist-generated=true
.agents/skills/** linguist-generated=true
uv.lock linguist-generated=true

# A recorded stream is read back byte for byte by a golden test, so no checkout
# rewrites its line endings.
tests/fixtures/** -text

# Vendored release files are checked against upstream by checksum, so a
# checkout must not rewrite their line endings.
src/dreamcatcher/static/vendor/** -text

# init writes the default configuration into a user's checkout as it is here,
# so no checkout rewrites its line endings.
src/dreamcatcher/default_config.toml text eol=lf
